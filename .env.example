# =============================================================================
# TriageFlow - environment configuration for the root docker-compose.yml
#
#   cp .env.example .env
#
# Never commit .env. Every value below is a placeholder, not a secret. The compose
# file has working local defaults, so .env is optional for a first local run but
# REQUIRED to be edited before the stack is reachable from the internet.
# =============================================================================

# ---- PostgreSQL --------------------------------------------------------------
# Keep the password URL-safe (letters, digits, - and _): it is embedded in DATABASE_URL.
POSTGRES_USER=triageflow
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=triageflow
# Separate database for the ML service (created on first boot of the DB volume).
ML_POSTGRES_DB=triageflow_ml

# ---- Backend (FastAPI) -------------------------------------------------------
ENV=development
DEBUG=false
# Generate one:  openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Comma-separated browser origins allowed to call the API. Add your deployed frontend URL.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# true = run app/seed.py at start-up (demo users, tickets). Idempotent. Set false once a
# public deployment has real accounts; the seeded demo password is public in the README.
SEED_ON_STARTUP=true

# ---- ML service --------------------------------------------------------------
LOG_LEVEL=INFO
# Retraining is recommended when this many approved, not-yet-exported corrections exist...
RETRAIN_MIN_APPROVED_CORRECTIONS=50
# ...or when the active model is at least 7 days old (and this switch is true).
RETRAIN_WEEKLY_ENABLED=true
# A candidate whose category weighted-F1 drops by more than this vs. the active model is blocked.
RETRAIN_REGRESSION_TOLERANCE=0.01

# ---- Host ports --------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
# ML service and Postgres are published on 127.0.0.1 only.
ML_SERVICE_PORT=8001
POSTGRES_PORT=5433

# =============================================================================
# GitHub Actions (Settings -> Secrets and variables -> Actions). Not read from .env.
# Only needed for the retraining workflows; CI itself needs no secrets.
#
#   ML_SERVICE_URL          secret, optional  Base URL of a deployed ML service, e.g. https://ml.example.com
#                                             Unset = the workflows run a self-contained dry run instead.
#   ML_SERVICE_AUTH_HEADER  secret, optional  Full header line your gateway expects, e.g. "X-Api-Key: <value>"
#                                             (the ML service has no built-in auth; see docs/DEPLOYMENT.md)
# =============================================================================
