# ---- App ----
ENV=development
DEBUG=true
PROJECT_NAME=TriageFlow

# ---- Database ----
# Used by the running app (docker-compose sets this automatically for the app container)
DATABASE_URL=postgresql+psycopg2://triageflow:triageflow@localhost:5432/triageflow

# ---- Auth ----
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---- CORS ----
# Comma separated list of allowed origins for the React frontend
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ---- Seed / demo ----
SEED_ON_STARTUP=false
