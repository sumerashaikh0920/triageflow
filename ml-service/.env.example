# ---- Database (existing FastAPI/PostgreSQL backend shares this DB or a dedicated ML schema) ----
DATABASE_URL=postgresql+psycopg2://triageflow:triageflow@localhost:5432/triageflow

# ---- Service ----
ML_SERVICE_ENV=local
LOG_LEVEL=INFO

# ---- Model / registry ----
MODEL_REGISTRY_DIR=./models
ACTIVE_MODEL_ENV_OVERRIDE=

# ---- Retraining triggers ----
RETRAIN_MIN_APPROVED_CORRECTIONS=50
RETRAIN_WEEKLY_ENABLED=true
RETRAIN_REGRESSION_TOLERANCE=0.01

# ---- Routing config ----
ROUTING_RULES_PATH=./app/inference/routing_rules.yaml
